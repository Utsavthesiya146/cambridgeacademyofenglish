# Cambridge Academy of English – Environment Configuration Template

# 1. Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Google Search Console Verification Meta Tag
NEXT_PUBLIC_GSC_VERIFICATION_ID=your_gsc_verification_code_here

# 3. Official WhatsApp Number (Format with country code: +918970506004)
NEXT_PUBLIC_WHATSAPP_NUMBER=+918970506004

# 4. Admin Secret Key for Lead & Certificate Portal (/admin/leads)
# REQUIRED: Must be set in server environment. Minimum 16 random characters recommended.
ADMIN_SECRET_KEY=your_strong_random_admin_secret_key_minimum_16_chars

# 5. Lead Email Notifications (Nodemailer SMTP - Hostinger / Standard Mail Server)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admissions@cambridgeacademyofenglish.com
SMTP_PASS=your_smtp_mailbox_password_here
SMTP_FROM_EMAIL="Cambridge Academy Admissions" <admissions@cambridgeacademyofenglish.com>
ADMISSIONS_EMAIL=info@cambridgeacademyofenglish.com

# 6. Optional CRM/Slack/Discord Lead Notification Webhook
LEAD_NOTIFICATION_WEBHOOK=

# 7. Custom Storage Directory (Optional)
# LEADS_STORAGE_DIR=/var/data/cambridge_leads

# 8. MySQL Database Connection (Prisma ORM - Hostinger MySQL / Cloud MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://u123456789_cae_user:your_mysql_password_here@srv123.hostinger.com:3306/u123456789_cae_db"

# 9. Official Google Places & Maps Integration (Cambridge Academy of English, Kammanahalli)
NEXT_PUBLIC_GOOGLE_MAPS_LINK="https://www.google.com/maps/search/?api=1&query=Cambridge+Academy+of+English+Kammanahalli+Bangalore"
GOOGLE_PLACE_ID="ChIJ-ZTkoiYXrj4RKGNuprTxD7M"
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

